{
  "compilerOptions": {
    "rootDir": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    // Off deliberately — do not turn this back on. `tsc` runs here only as
    // `--noEmit` (the `typecheck` script); the published `dist/index.d.ts` comes
    // from tsup's dts rollup, which INLINES the SDK types and emits a
    // self-contained file. The SDK re-exports those types from an internal chunk
    // (`@xano/sdk/dist/response-*.d.ts`) that the package's
    // `exports` map does not expose, so a declaration-emitting `tsc` cannot name
    // the inferred type of any def and raises TS2742 on all four. Annotating the
    // defs to satisfy it would erase the inference that IS the contract here —
    // `auth/me`'s derived `PublicUser | null` most of all.
    "declaration": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test", "scripts"],
  "exclude": ["dist", "node_modules"]
}
